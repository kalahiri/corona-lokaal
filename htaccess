Options +FollowSymlinks
RewriteEngine on

## ALLEEN VOOR DE LIVE-OMGEVING, NIET VOOR DE ONTWIKKEL-OMGEVING ##
## Alles wordt doorverwezen van HTTP naar HTTPS
RewriteCond %{SERVER_PORT} !^443$ 
RewriteCond %{HTTPS} !on
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

## Alles wordt doorverwezen van HTTPS naar HTTP
# RewriteCond %{SERVER_PORT} ^443$ 
# RewriteCond %{HTTPS} on
# RewriteRule (.*) http://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]



## ALLEEN VOOR DE LIVE-OMGEVING, NIET VOOR DE ONTWIKKEL-OMGEVING ##
## Forceer altijd "www."
RewriteCond %{HTTP_HOST} !^$
RewriteCond %{HTTP_HOST} !^www\.
RewriteRule ^(.*)$ http://www.%{HTTP_HOST}/$1 [R=301,L]

# doorverwijzing
RewriteRule ^location/Nederland/plant/(.*) https://www.corona-lokaal.nl/locatie/Nederland/waterzuivering/$1 [R=301,L]
RewriteRule ^location/(.*)/plant/(.*) https://www.corona-lokaal.nl/gemeente/$1/waterzuivering/$2 [R=301,L]
RewriteRule ^locatie/Nederland/plant/(.*) https://www.corona-lokaal.nl/locatie/Nederland/waterzuivering/$1 [R=301,L]
RewriteRule ^locatie/(.*)/plant/(.*) https://www.corona-lokaal.nl/gemeente/$1/waterzuivering/$2 [R=301,L]
RewriteRule ^location/Nederland https://www.corona-lokaal.nl/locatie/Nederland [R=301,L]
RewriteRule ^location/(.*) https://www.corona-lokaal.nl/gemeente/$1 [R=301,L]

# Herschrijf de mooie url's
RewriteRule ^locatie/(.*)/waterzuivering/(.*) index.php?location=$1&plant=$2 [L]
RewriteRule ^gemeente/(.*)/waterzuivering/(.*) index.php?location=$1&plant=$2 [L]
RewriteRule ^locatie/(.*) index.php?location=$1 [L]
RewriteRule ^gemeente/(.*) index.php?location=$1 [L]
RewriteRule ^csv/location/(.*) getcsv.php?location=$1 [L]
RewriteRule ^csv/(.*) getcsv.php [L]
RewriteRule ^downloadcsv/(.*) downloadcsv.php [L]



## Deze is nodig voor de oude manier van file-fingerprinting
RewriteRule ^(.*)\.[\d]{10}\.(css|js|ico|png|jpg|jpeg|svg|gif)$ $1.$2 [L]

## voorkom deeplinking van bepaalde directory's. Niet handig voor delen op social media.
